# =====================================================================
# .gitignore - La Bonne M'Air (ModuleAir)
# Fichiers que git ne suit pas : secrets, fichiers fabriqués, fichiers parasites.
# Vérifier un fichier : git check-ignore -v chemin/du/fichier
# =====================================================================

# ---------------------------------------------------------------------
# SECRETS : ne doivent JAMAIS être publiés
# ---------------------------------------------------------------------
# Clé PRIVÉE de signature des mises à jour (et toute copie de sauvegarde)
Firmware/outils/cle_privee_ota.pem
*.pem
# Secrets locaux (Wrangler, scripts)
.env
*.env
relais/.dev.vars*
# Réglages locaux de Claude Code (autorisations, chemins personnels)
.claude/settings.local.json
CLAUDE.local.md

# ---------------------------------------------------------------------
# PlatformIO / VS Code : fichiers fabriqués à la compilation
# ---------------------------------------------------------------------
Firmware/.pio/
Firmware/.vscode/
.vscode/
# Numéro de version fabriqué à chaque compilation (outils/ota.py)
Firmware/src/version_fw.h
# Programme signé prêt à publier (firmware.bin + firmware.json : à joindre à une release GitHub)
Firmware/ota/
__pycache__/
*.pyc
.venv/
venv/

# ---------------------------------------------------------------------
# Relais Cloudflare
# ---------------------------------------------------------------------
node_modules/
.wrangler/

# ---------------------------------------------------------------------
# Fichiers temporaires
# ---------------------------------------------------------------------
# Correctifs (git apply)
*.patch
*.orig
*.rej
# Installeurs eduroam téléchargés depuis cat.eduroam.org (le certificat utile est dans ca_eduroam.h)
eduroam-*.py
# Journaux : un enregistrement du moniteur série contient ce qui a été tapé, MOTS DE PASSE compris
*.log
*.bak
*.tmp
*~
*.swp

# ---------------------------------------------------------------------
# Fichiers parasites (système, autres éditeurs)
# ---------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.idea/
